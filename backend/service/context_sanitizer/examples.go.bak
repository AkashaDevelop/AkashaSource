// Example7_TestCases 测试用例示例
func Example7_TestCases() {
	// 伪代码示例: 单元测试

	/*
		// 测试 1: 响应工具调用校验
		func TestValidateResponseToolCalls(t *testing.T) {
			requestTools := []interface{}{
				map[string]any{
					"type": "function",
					"function": map[string]any{
						"name": "get_weather",
					},
				},
			}

			// 合法工具调用
			validToolCall := dto.Tool{
				Function: dto.FunctionCall{
					Name:      "get_weather",
					Arguments: `{"city": "Beijing"}`,
				},
			}
			findings := validateResponseToolCalls([]dto.Tool{validToolCall}, requestTools, defaultPolicy())
			assert.Equal(t, 0, len(findings))

			// 非法工具调用: 未声明
			invalidToolCall := dto.Tool{
				Function: dto.FunctionCall{
					Name:      "delete_user",
					Arguments: `{}`,
				},
			}
			findings = validateResponseToolCalls([]dto.Tool{invalidToolCall}, requestTools, defaultPolicy())
			assert.Greater(t, len(findings), 0)
			assert.Equal(t, "undeclared_response_tool_call", findings[0].Type)
		}

		// 测试 2: 多模态检测
		func TestMultimodalDetection(t *testing.T) {
			messages := []interface{}{
				map[string]any{
					"role": "user",
					"content": []any{
						map[string]any{"type": "text", "text": "Describe this image"},
						map[string]any{
							"type": "image_url",
							"image_url": map[string]any{
								"url": "https://untrusted.example.com/image.jpg",
							},
						},
					},
				},
			}

			findings := detectMultimodalRisks(messages, defaultPolicy())
			assert.Greater(t, len(findings), 0)
			assert.Equal(t, "multimodal_blind_spot", findings[0].Type)
		}

		// 测试 3: Token 风险累积
		func TestTokenRiskTracking(t *testing.T) {
			tokenId := 12345

			// 初始风险基线应为 0
			assert.Equal(t, 0, GetTokenRiskFloor(tokenId))

			// 触发 5 次
			for i := 0; i < 5; i++ {
				RecordTokenTrigger(tokenId, "payload_"+strconv.Itoa(i), 60)
			}

			// 风险基线应已提升
			riskFloor := GetTokenRiskFloor(tokenId)
			assert.Greater(t, riskFloor, 0)

			// 触发次数应为 5
			assert.Equal(t, 5, GetTokenTriggerCount(tokenId))
		}

		// 测试 4: 混淆字符规范化
		func TestConfusablesNormalization(t *testing.T) {
			// Cyrillic а (U+0430) -> Latin a
			input := "tool_саlls" // 其中 'c' 是 Cyrillic с
			normalized := normalizeConfusables(input)
			assert.Contains(t, normalized, "tool_calls")

			// RTL override
			inputRTL := "ignore‮previous"
			normalizedRTL := normalizeConfusables(inputRTL)
			assert.NotContains(t, normalizedRTL, "‮")
		}
	*/
}

// 辅助函数示例
func defaultPolicy() ResolvedPolicy {
	return ResolvedPolicy{
		Policy: &model.ContextSanitizationPolicy{
			Mode:    ModeProtect,
			Enabled: true,
		},
		Config: DefaultConfig(),
	}
}

// 注意: 这些示例代码是伪代码,展示集成点和使用方式
// 实际集成时需要根据项目实际结构调整
