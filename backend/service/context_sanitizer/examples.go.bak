			if err != nil {
				common.LogError(c.Request.Context(), "response sanitizer error: "+err.Error())
				// 降级: 使用原始响应
				result = &context_sanitizer.ResponseResult{Body: bodyBytes}
			}

			if result.Blocked {
				c.JSON(http.StatusForbidden, gin.H{
					"error": gin.H{
						"message": result.Message,
